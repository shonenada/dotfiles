[user]
    name = shonenada
    email = shonenada@gmail.com
    signingkey = 
[color]
    ui = auto
[alias]
    lg = log --color --graph --pretty=format:'%Cred%h%Creset - %C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --numstat --
    ci = commit
    cim = commit -m
    cam  = commit --amend
    mg = merge --no-ff
    st = status
    br = branch
    brs = branch -v
    res = remote -v
    co = checkout
    df = diff --no-ext-diff
    upup = pull --ff-only upstream
    um = pull --ff-only upstream master
    up = pull --ff-only
    pu = pull
    biu = !git branch --merged | grep -v '*' | grep -v 'master$' | grep -v 'release$' | xargs -n 1 git branch -d
    kaca = !git branch --merged | grep -v '*' | grep -v 'master$' | grep -v 'release$'
    cdf = "!git diff $@ | ydiff; true"
    sdf = "!git diff $@ | ydiff -s -w 0; true"
    pk = cherry-pick
    wtf = !git commit -m"\"`curl -L -s https://commitlog.wolege.ca`"\"
[push]
    default = current
[commit]
    gpgsign = true

[user]
    name = shonenada
    email = shonenada@gmail.com
[color]
    ui = auto
[alias]
    lg = log --color --graph --pretty=format:'%Cred%h%Creset - %C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
    alg = log --all --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    ci = commit
    cim = commit -m
    st = status
    stb = status -sb
    br = branch
    co = checkout
    df = diff --no-ext-diff
    up = pull --ff-only
    biu = !git branch --merged | grep -v '*' | grep -v 'master$' | xargs -n 1 git branch -d
    upup = pull upstream
[push]
    default = current

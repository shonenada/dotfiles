{
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        },
        {
            "before": ["j", "K"],
            "after": ["<Esc>"]
        },
        {
            "before": ["J", "k"],
            "after": ["<Esc>"]
        },
        {
            "before": ["J", "K"],
            "after": ["<Esc>"]
        },
        {
            "before": ["<C-j>"],
            "after": ["<Down>"]
        },
        {
            "before": ["<C-k>"],
            "after": ["<Up>"]
        },
        {
            "before": ["<C-l>"],
            "after": ["<Right>"]
        },
        {
            "before": ["<C-h>"],
            "after": ["<Left>"]
        },
    ],

    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

    "git.ignoreMissingGitWarning": true,
    "editor.rulers": [
        80,
        120
    ],

    "editor.wordWrap": "wordWrapColumn",
    "[markdown]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 80,
    },
}
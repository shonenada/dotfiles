# theme = tokyonight
# theme = Catppuccin Macchiato
# font-family = CaskaydiaCove Nerd Font Mono
# font-family = Menlo
# font-size = 18
macos-option-as-alt = true

# Fix Alt+arrow sending readline sequences (e.g. \x1bf) instead of xterm
# modifiers, which causes Alt+Right to collide with Alt+f in Zellij
keybind = alt+right=text:\x1b[1;3C
keybind = alt+left=text:\x1b[1;3D
keybind = alt+up=text:\x1b[1;3A
keybind = alt+down=text:\x1b[1;3B

shell-integration = zsh
shell-integration-features = true
mouse-scroll-multiplier = 3

background-opacity = 1
background-blur = false

unfocused-split-opacity = 0.7
unfocused-split-fill = #181926
# split-divider-color = Dark Slate Gray

# Always treat Cmd+C/V as copy/paste and DO NOT pass "c" through
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# for fix claude code new line
keybind = shift+enter=text:\x1b\r

# Percentage, primary axis only
quick-terminal-position = bottom
# multi size seems doesnt work
quick-terminal-size = 25%,50%
# keybind = global:cmd+¡=toggle_quick_terminal

# https://github.com/dlants/dotfiles/tree/main/ghostty/shaders
